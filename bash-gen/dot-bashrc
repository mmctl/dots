# .bashrc

# Exit when non-interactive 
[[ $- != *i* ]] && return

# User-specific base setup
config_base_dir="$XDG_CONFIG_HOME/bash/base"
if [[ -d "$config_base_dir" ]]; then
    shopt -s nullglob
    for rc in "$config_base_dir"/*; do
	[[ -f "$rc" ]] && . "$rc"
    done
    shopt -u nullglob
fi
unset rc

# Exit when terminal capabilities too limited
[[ ${TERM:-dumb} == dumb || ${TERM:-dumb} == linux ]] && return

# BLE (preload)
if [[ $- == *i* && -f "$XDG_DATA_HOME/bash/blesh/ble.sh" ]]; then
    . "$XDG_DATA_HOME/bash/blesh/ble.sh" --attach=none
fi

# Extensions and integrations
if [[ -z ${BLE_VERSION-} ]]; then
    # No BLE loaded, so enable integrations manually 
    [[ -f /etc/profile.d/bash_completion.sh ]] && . /etc/profile.d/bash_completion.sh
    command -v fzf >/dev/null && eval "$(fzf --bash)"
    command -v fd >/dev/null && eval "$(fd --gen-completions bash)"
    command -v zoxide > /dev/null && eval "$(zoxide init bash)"
    
    # User-specific runcommands (extensions)
    config_extensions_dir="$XDG_CONFIG_HOME/bash/extensions"
    if [[ -d "$config_extensions_dir" ]]; then
        shopt -s nullglob
        for rc in "$config_extensions_dir"/*; do
            [[ -f "$rc" ]] && . "$rc"
        done
        shopt -u nullglob
    fi
    unset rc
else
    # BLE loaded, so attach (integrations loaded in BLE config)
    ble-attach
fi


# Prompt
command -v starship >/dev/null && eval "$(starship init bash)"

