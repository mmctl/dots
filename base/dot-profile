# Ensure .profile is loaded only once (unless explicitly circumvented)
if [ -n "${PROFILE_LOADED-}" ]; then
  return 0 2>/dev/null || exit 0
fi
export PROFILE_LOADED=1


# Environment variables
## Locale
export LANG='en_US.UTF-8'


## Default locations (config, cache, etc.)
### XDG
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

export XDG_BIN_HOME="$HOME/.local/bin"

### Scripts
export LIBEXEC_DIR="$HOME/.local/libexec"

### Shells
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export ZPLUGDIR="$XDG_DATA_HOME/zsh/plugins"

### PARA
export PROJECTS_DIR="$HOME/projects"
export AREAS_DIR="$HOME/areas"
export RESOURCES_DIR="$HOME/resources"
export ARCHIVES_DIR="$HOME/archives"

### Dotfiles
export DOTS_DIR="$XDG_DATA_HOME/dots"

### Maildir
export MAILDIR="$XDG_DATA_HOME/mail"

### SSH
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

### Authinfo
export AUTHINFO_FILE="$XDG_DATA_HOME/.authinfo.gpg"

### Sources
export SRCS_DIR="$XDG_DATA_HOME/srcs"

### Readline
export INPUTRC="$XDG_CONFIG_HOME/readline/inputrc"

### BAT
export BAT_CONFIG_PATH="$XDG_CONFIG_HOME/bat/config"

### FZF
export FZF_DEFAULT_OPTS_FILE="$XDG_CONFIG_HOME/fzf/fzf.conf"

### Ripgrep
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/rg.conf"

### OPAM
export OPAMROOT="$XDG_DATA_HOME/opam"

### Rust/Cargo
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$XDG_DATA_HOME/cargo"

### GO
export GOPATH="$XDG_DATA_HOME/go"
export GOBIN="$GOPATH/bin"

### LEAN
export ELAN_HOME="$XDG_DATA_HOME/elan"


## Default programs
export PAGER='less'
export MANPAGER='less'
export SUDO_EDITOR='nano'
export EDITOR='emacsclient -t --alternate-editor='
export VISUAL='emacsclient -c --alternate-editor='
export ALTERNATE_EDITOR='' # This will spawn an emacs daemon upon running emacsclient (if no daemon is running yet)


## Options
export LESS='-g -i -J -N -Q -R -W --incsearch --tabs=4 --line-num-width=5 --mouse --use-color --wheel-lines=3'
export LESSUTFCHARDEF='E000-F8FF:p,F0000-FFFFD:p,100000-10FFFD:p'


## Paths
### Executables
PATH="$CARGO_HOME/bin:$PATH"
PATH="$GOBIN:$PATH:/usr/local/go/bin"
PATH="$ELAN_HOME/bin:$PATH"
PATH="$XDG_BIN_HOME:$PATH"
export PATH
