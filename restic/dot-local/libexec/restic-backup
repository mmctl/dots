#!/usr/bin/env sh
set -eu


notify() {
    urgency=$1
    title=$2
    body=$3

    notify-send \
        --app-name="Backup: $RESTIC_BACKUP_NAME" \
        --icon=drive-harddisk \
        --urgency="$urgency" \
        "$title" \
        "$body" \
        >/dev/null 2>&1 || true
}


mounted_here=0
attempted=0
backup_ok=0
maintenance_ok=0
unmount_ok=1

cleanup() {
    status=$?

    trap - EXIT HUP INT TERM

    if [ "$mounted_here" -eq 1 ]; then
        if ! umount "$BACKUP_MOUNTPOINT"; then
            unmount_ok=0
            status=1
        fi
    fi

    if [ "$attempted" -eq 1 ]; then
        if [ "$backup_ok" -ne 1 ]; then
            notify critical \
                   "Backup failed" \
                   "Backup did not complete. Inspect: journalctl --user -u restic-backup@$RESTIC_BACKUP_NAME.service"
        elif [ "$maintenance_ok" -ne 1 ]; then
            notify critical \
                   "Backup succeeded; maintenance failed" \
                   "Backup completed successfully, but retention or pruning failed."
        elif [ "$unmount_ok" -ne 1 ]; then
            notify critical \
                   "Backup and maintenance succeeded; drive still mounted" \
                   "Backup and maintenance completed successfully, but backup drive could not be unmounted."
        elif [ "$mounted_here" -eq 1 ]; then
            notify normal \
                   "Backup and maintenance succeeded; drive unmounted" \
                   "Backup and maintenance completed successfully and backup drive has been unmounted."
        else
            notify normal \
                   "Backup and maintenance succeeded; drive remains mounted" \
                   "Backup and maintenance completed successfully. The backup drive was already mounted before and remains mounted."
        fi
    fi

    exit "$status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM


if [ ! -e "/dev/disk/by-uuid/$BACKUP_FS_UUID" ]; then
    printf 'Backup drive (UUID: %s) is not connected; skipping backup.\n' "$BACKUP_FS_UUID"

    notify low \
           "Backup skipped" \
           "The $RESTIC_BACKUP_NAME backup drive is not connected (UUID: $BACKUP_FS_UUID)."

    exit 0
fi


if mountpoint -q "$BACKUP_MOUNTPOINT"; then
    actual_uuid="$(findmnt -rn --mountpoint "$BACKUP_MOUNTPOINT" --output UUID || true)"

    if [ -z "$actual_uuid" ]; then
        printf 'Could not determine mounted filesystem UUID for %s.\n' "$BACKUP_MOUNTPOINT" >&2
        exit 1
    fi

    if [ "$actual_uuid" != "$BACKUP_FS_UUID" ]; then
        printf 'Backup mountpoint is occupied by a different filesystem.\n' >&2
        printf '  Mountpoint: %s\n' "$BACKUP_MOUNTPOINT" >&2
        printf '  Expected:   %s\n' "$BACKUP_FS_UUID" >&2
        printf '  Actual:     %s\n' "$actual_uuid" >&2
        exit 1
    fi

    printf 'Backup filesystem already mounted at %s.\n' "$BACKUP_MOUNTPOINT"
    mounted_here=0
else
    mount "$BACKUP_MOUNTPOINT"
    mounted_here=1
fi


attempted=1


actual_repository_id="$(restic --quiet cat config | jq -er '.id')"

if [ "$actual_repository_id" != "$RESTIC_EXPECTED_REPOSITORY_ID" ]; then
    printf 'Configured Restic repository has an unexpected ID.\n' >&2
    printf '  Repository: %s\n' "$RESTIC_REPOSITORY" >&2
    printf '  Expected:   %s\n' "$RESTIC_EXPECTED_REPOSITORY_ID" >&2
    printf '  Actual:     %s\n' "$actual_repository_id" >&2
    exit 1
fi


notify normal \
       "Backup started" \
       "Backing up $RESTIC_BACKUP_SOURCE to $RESTIC_REPOSITORY..."

restic backup \
    --tag "$RESTIC_BACKUP_NAME" \
    --tag automatic \
    --one-file-system \
    --exclude-caches \
    --exclude-file "$RESTIC_EXCLUDE_FILE" \
    "$RESTIC_BACKUP_SOURCE"

backup_ok=1

restic forget \
    --tag "$RESTIC_BACKUP_NAME" \
    --keep-last 1 \
    --keep-daily "$RESTIC_KEEP_DAILY" \
    --keep-weekly "$RESTIC_KEEP_WEEKLY" \
    --keep-monthly "$RESTIC_KEEP_MONTHLY" \
    --keep-yearly "$RESTIC_KEEP_YEARLY" \
    --prune

maintenance_ok=1
