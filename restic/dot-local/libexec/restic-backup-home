#!/usr/bin/env sh
set -eu

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/restic/backup-home.conf"

if [ ! -r "$config_file" ]; then
    printf 'Missing restic home backup configuration: %s\n' "$config_file" >&2
    exit 1
fi

. "$config_file"


notify() {
    urgency=$1
    title=$2
    body=$3

    notify-send \
        --app-name="Backup: Home" \
        --icon=drive-harddisk \
        --urgency="$urgency" \
        "$title" \
        "$body" \
        >/dev/null 2>&1 || true
}


mounted_here=0
attempted=0
backup_ok=0
maintenance_ok=0
unmount_ok=1

cleanup() {
    status=$?

    trap - EXIT HUP INT TERM

    if [ "$mounted_here" -eq 1 ]; then
        if ! umount "$BACKUP_MOUNTPOINT"; then
            unmount_ok=0
            status=1
        fi
    fi

    if [ "$attempted" -eq 1 ]; then
        if [ "$backup_ok" -ne 1 ]; then
            notify \
                critical \
                "Backup failed" \
                "Backup did not complete. Inspect: journalctl --user -u restic-backup-home.service"
        elif [ "$maintenance_ok" -ne 1 ]; then
            notify \
                critical \
                "Backup succeeded; maintenance failed" \
                "Backup completed successfully, but retention or pruning failed."
        elif [ "$unmount_ok" -ne 1 ]; then
            notify \
                critical \
                "Backup and maintenance succeeded; drive still mounted" \
                "Backup and maintenance completed successfully, but backup drive could not be unmounted."
        elif [ "$mounted_here" -eq 1 ]; then
            notify \
                normal \
                "Backup and maintanance succeeded; drive unmounted" \
                "Backup and maintainance completed successfully and backup drive has been unmounted."
        else
            notify \
                normal \
                "Backup and maintanance succeeded; drive remains mounted" \
                "Backup and maintainance completed successfully. The backup drive was already mounted before and remains mounted."
        fi
    fi

    exit "$status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM


if [ ! -e "$BACKUP_DEVICE" ]; then
    printf 'Backup drive is not connected; skipping backup.\n'
    exit 0
fi


if mountpoint -q "$BACKUP_MOUNTPOINT"; then
    expected_source="$(readlink -f -- "$BACKUP_DEVICE")"
    actual_source="$(findmnt -rn --target "$BACKUP_MOUNTPOINT" --output SOURCE)"
    actual_source="$(readlink -f -- "$actual_source")"

    if [ "$actual_source" != "$expected_source" ]; then
        printf '%s\n' "Backup mountpoint is occupied by a different filesystem." >&2
        printf '  Mountpoint:  %s\n' "$BACKUP_MOUNTPOINT" >&2
        printf '  Expected:    %s -> %s\n' "$BACKUP_DEVICE" "$expected_source" >&2
        printf '  Actual:      %s\n' "$actual_source" >&2
        exit 1
    fi

    mounted_here=0
else
    mount "$BACKUP_MOUNTPOINT"
    mounted_here=1
fi


attempted=1


notify \
    normal \
    "Backup started" \
    "Backing up $RESTIC_BACKUP_SOURCE to $RESTIC_REPOSITORY..."

restic \
    --repo "$RESTIC_REPOSITORY" \
    --password-command "$RESTIC_PASSWORD_COMMAND" \
    backup \
    --tag home \
    --tag automatic \
    --one-file-system \
    --exclude-caches \
    --exclude-file "$RESTIC_EXCLUDE_FILE" \
    "$RESTIC_BACKUP_SOURCE"

backup_ok=1

restic \
    --repo "$RESTIC_REPOSITORY" \
    --password-command "$RESTIC_PASSWORD_COMMAND" \
    forget \
    --tag home \
    --keep-last 1 \
    --keep-daily "$RESTIC_KEEP_DAILY" \
    --keep-weekly "$RESTIC_KEEP_WEEKLY" \
    --keep-monthly "$RESTIC_KEEP_MONTHLY" \
    --keep-yearly "$RESTIC_KEEP_YEARLY" \
    --prune

maintenance_ok=1
