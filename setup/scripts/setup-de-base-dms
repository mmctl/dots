#!/usr/bin/env sh
set -eu

# Setup utilities
script_dir="$(dirname -- "$(realpath "$0")")"
. "$script_dir/utils"


if [ "$(id -u)" -eq 0 ]; then
    setup_log_die "Run this script as the target regular user, not as root."
fi

if ! command -v zypper >/dev/null 2>&1; then
    setup_log_die "zypper is not available; this script is intended for openSUSE."
fi

setup_log_info "This script needs sudo for system configuration."
sudo -v || setup_log_die "Failed to obtain valid sudo credentials."


for bcmd in git make curl gpg2 stow; do
    if ! command -v "$bcmd" >/dev/null 2>&1; then
        setup_log_info "$bcmd is not installed. Installing..."
        sudo zypper --non-interactive --no-color install "$bcmd"
        setup_log_info "Installed $bcmd."
    fi
done

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DOTS_DIR="${DOTS_DIR:-$XDG_DATA_HOME/dots}"
SRCS_DIR="${SRCS_DIR:-$XDG_DATA_HOME/srcs}"

if [ ! -d "$DOTS_DIR" ]; then
    setup_log_die "dotfiles directory not found: $DOTS_DIR"
fi

REPLACE_PLACEHOLDER="${REPLACE_PLACEHOLDER:-$DOTS_DIR/setup/scripts/replace-placeholder}"

if [ ! -x "$REPLACE_PLACEHOLDER" ]; then
    setup_log_die "replace-placeholder script not found or not executable: $REPLACE_PLACEHOLDER"
fi


setup_log_info "Installing basic desktop runtime for Wayland..."
sudo zypper --non-interactive --no-color install \
     libdrm2 Mesa Mesa-dri Mesa-libEGL1 Mesa-libGL1 Mesa-libva Mesa-vulkan-device-select \
     dbus-1 dbus-1-tools \
     libwayland-server0 libwayland-client0 libwayland-egl1 \
     pam-config polkit polkit-default-privs gnome-keyring gnome-keyring-pam secret-tool \
     pipewire wireplumber \
     xdg-desktop-portal xdg-desktop-portal-gtk libnotify-tools \
     xwayland \
     bluez
setup_log_info "Installed basic desktop runtime for Wayland."


setup_log_info "Installing graphical toolkits, themes, and fonts..."
sudo zypper --non-interactive --no-color install \
     gtk3 gtk4 \
     adwaita-fonts adwaita-icon-theme adwaita-icon-theme-legacy gtk3-metatheme-adwaita \
     iosevka-fonts iosevka-slab-fonts iosevka-aile-fonts iosevka-etoile-fonts symbols-only-nerd-fonts
setup_log_info "Installing graphical toolkits, themes and fonts."


setup_log_info "Installing terminal emulator (Kitty) and shell enhancements..."

sudo zypper --non-interactive --no-color install \
     kitty zsh bash-completion \
     fzf fd ripgrep zoxide starship \
     fzf-zsh-integration fd-zsh-completion ripgrep-zsh-completion

mkdir -p -- "$SRCS_DIR"
clone_or_update --recurse-submodules \
                'https://github.com/akinomyoga/ble.sh.git' \
                "$SRCS_DIR/blesh/"
make -C "$SRCS_DIR/blesh" install

ZPLUGDIR="${ZPLUGDIR:-$XDG_DATA_HOME/zsh/plugins}"
mkdir -p -- "$ZPLUGDIR"
clone_or_update 'https://github.com/zsh-users/zsh-autosuggestions.git' \
                "$ZPLUGDIR/zsh-autosuggestions"
clone_or_update 'https://github.com/zsh-users/zsh-syntax-highlighting.git' \
                "$ZPLUGDIR/zsh-syntax-highlighting"
clone_or_update 'https://github.com/Aloxaf/fzf-tab.git' \
                "$ZPLUGDIR/fzf-tab"

(cd -- "$DOTS_DIR" && stow readline ripgrep zsh)

setup_log_info "Installed terminal emulator (Kitty) and shell enhancements."


setup_log_info "Adding repositories for Quickshell environment..."

setup_log_info "Adding DankLinux repository..."
danklinux_repo_url='https://download.opensuse.org/repositories/home:AvengeMedia:danklinux/openSUSE_Tumbleweed/'
danklinux_repo_alias='danklinux'

if zypper lr "$danklinux_repo_alias" >/dev/null 2>&1; then
    setup_log_info "Repository '${danklinux_repo_alias}' already exists; skipping."
else
    danklinux_repo_key_url='https://download.opensuse.org/repositories/home:AvengeMedia:danklinux/openSUSE_Tumbleweed/repodata/repomd.xml.key'
    danklinux_repo_key_exp='20CA3E5804CA75009B3671A4284778483BC86115'

    setup_log_info "Handling DankLinux repository GPG key..."
    if ! download_and_import_rpm_key "$danklinux_repo_key_url" "$danklinux_repo_key_exp"; then
       setup_log_die "Failed to download, verify, and import DankLinux repository GPG key."
    fi
    setup_log_info "Handled DankLinux repository GPG key."

    sudo zypper --non-interactive --no-color addrepo -cf "$danklinux_repo_url" "$danklinux_repo_alias"
    setup_log_info "Added DankLinux repository."

    setup_log_info "Refreshing DankLinux repository..."
    sudo zypper --non-interactive --no-color --gpg-auto-import-keys refresh "$danklinux_repo_alias"
    setup_log_info "Refreshed DankLinux repository."
fi

setup_log_info "Adding DMS repository..."
dms_repo_url='https://download.opensuse.org/repositories/home:/AvengeMedia:/dms/openSUSE_Tumbleweed/'
dms_repo_alias='dms'

if zypper lr "$dms_repo_alias" >/dev/null 2>&1; then
    setup_log_info "Repository '${dms_repo_alias}' already exists; skipping."
else
    dms_repo_key_url='https://download.opensuse.org/repositories/home:AvengeMedia:dms/openSUSE_Tumbleweed/repodata/repomd.xml.key'
    dms_repo_key_exp='20CA3E5804CA75009B3671A4284778483BC86115'

    setup_log_info "Handling DMS repository GPG key..."
    if ! download_and_import_rpm_key "$dms_repo_key_url" "$dms_repo_key_exp"; then
       setup_log_die "Failed to download, verify, and import DMS repository GPG key."
    fi
    setup_log_info "Handled DMS repository GPG key."

    sudo zypper --non-interactive --no-color addrepo -cf "$dms_repo_url" "$dms_repo_alias"
    setup_log_info "Added DMS repository."

    setup_log_info "Refreshing DMS repository..."
    sudo zypper --non-interactive --no-color --gpg-auto-import-keys refresh "$dms_repo_alias"
    setup_log_info "Refreshed DMS repository."
fi

setup_log_info "Added repositories for Quickshell environment."


setup_log_info "Installing Wayland compositor (Niri).."
sudo zypper --non-interactive --no-color install niri
setup_log_info "Installed Wayland compositor (Niri)."


setup_log_info "Installing Quickshell environment..."

sudo zypper --non-interactive --no-color install dms quickshell matugen dgop greetd dms-greeter

(cd -- "$DOTS_DIR" && stow dms environment-dms matugen-dms niri-dms wallpapers)
"$REPLACE_PLACEHOLDER" XDG_CONFIG_HOME "$XDG_CONFIG_HOME" \
    "$XDG_CONFIG_HOME/DankMaterialShell/settings-temp.json" \
    "$XDG_CONFIG_HOME/DankMaterialShell/settings.json"

"$REPLACE_PLACEHOLDER" XDG_DATA_HOME "$XDG_DATA_HOME" \
    "$XDG_STATE_HOME/DankMaterialShell/session-temp.json" \
    "$XDG_STATE_HOME/DankMaterialShell/session.json"

rm -f -- "$HOME/.bashrc"
(cd -- "$DOTS_DIR" && stow kitty-gen bash-gen fzf-gen starship-gen)

export DMS_PRIVESC='sudo'

dms setup outputs

systemctl --user daemon-reload
systemctl --user enable dms.service

dms greeter enable
dms greeter sync

sudo systemctl enable greetd

setup_log_info "Installed Quickshell environment."


setup_log_info "Installing graphical file manager (Nautilus)..."
sudo zypper --non-interactive --no-color install nautilus
setup_log_info "Installed graphical file manager (Nautilus)."


setup_log_info "Cleaning up..."
rm -f -- "$HOME/.bash_history $HOME/.inputrc"
setup_log_info "Cleaned up."


setup_log_action "Manual checkpoint:"
setup_log_action "  Reboot."
