#!/usr/bin/env sh
set -eu

# Setup utilities
script_dir="$(dirname -- "$(realpath "$0")")"
. "$script_dir/utils"


if [ "$(id -u)" -eq 0 ]; then
    setup_log_die "Run this script as the target regular user, not as root."
fi

if ! command -v zypper >/dev/null 2>&1; then
    setup_log_die "zypper is not available; this script is intended for openSUSE."
fi

for pcmd in rage pass-cli proton-drive protonmail-bridge; do
    if ! command -v "$pcmd" >/dev/null 2>&1; then
        setup_log_die "$pcmd is not available; please make sure it is installed."
    fi
done


setup_log_info "This script needs sudo for system configuration."
sudo -v || setup_log_die "Failed to obtain valid sudo credentials."


for bcmd in git stow; do
    ensure_command_from_package "$bcmd" "$bcmd"
done


XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"

DOTS_DIR="${DOTS_DIR:-$XDG_DATA_HOME/dots}"

if [ ! -d "$DOTS_DIR" ]; then
    setup_log_die "dotfiles directory not found: $DOTS_DIR"
fi

REPLACE_PLACEHOLDER="${REPLACE_PLACEHOLDER:-$DOTS_DIR/setup/scripts/replace-placeholder}"

if [ ! -x "$REPLACE_PLACEHOLDER" ]; then
    setup_log_die "replace-placeholder script not found or not executable: $REPLACE_PLACEHOLDER"
fi

ORG_PARENT_DIR_LOCAL="${ORG_PARENT_DIR_LOCAL:-$XDG_DATA_HOME}"
ORG_DIR_REMOTE="${ORG_DIR_REMOTE:-/my-files/sync/org}"

if ! proton-drive filesystem list "$ORG_DIR_REMOTE" >/dev/null 2>&1; then
   setup_log_die "Cannot access ORG data on remote ($ORG_DIR_REMOTE), please ensure you are logged in (proton-drive auth login)."
fi


AUTHINFO_FILE="${AUTHINFO_FILE:-$XDG_DATA_HOME/.authinfo.age}"
authinfo_dir="$(dirname -- "$AUTHINFO_FILE")"
install -d -m 700 "$authinfo_dir"

mkdir -p -- "$XDG_CONFIG_HOME/systemd/user/environment"

cat > "$XDG_CONFIG_HOME/systemd/user/environment/authinfo.conf" <<EOF
AUTHINFO_FILE="$AUTHINFO_FILE"
EOF

if [ -e "$AUTHINFO_FILE" ]; then
    setup_log_info "Authinfo file already exists; skipping creation: $AUTHINFO_FILE."
else
    if ! pass-cli test >/dev/null 2>&1; then
        setup_log_die "Cannot authenticate to password manager, please ensure you are logged in (pass-cli login)."
    fi

    (
        set +x

        recipient_dir="$XDG_CONFIG_HOME/age/recipients"

        set --
        recipient_count=0

        for recipient_file in "$recipient_dir"/*.recipient; do
            [ -f "$recipient_file" ] || continue

            set -- "$@" --recipients-file "$recipient_file"
            recipient_count=$((recipient_count + 1))
        done

        if [ "$recipient_count" -eq 0 ]; then
            setup_log_die "No age recipient files found in: $recipient_dir"
        fi

        umask 077

        authinfo_tmpdir="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/authinfo.XXXXXX")"
        authinfo_tmp="$authinfo_tmpdir/authinfo"

        authinfo_age_tmp="$(mktemp $authinfo_dir/.authinfo.age.XXXXXX)"

        trap 'rm -rf -- "$authinfo_tmpdir"; rm -f -- "$authinfo_age_tmp"' EXIT HUP INT TERM

        setup_log_info "Fetching credentials from password manager..."

        github_pers_user="$(pass-cli item view --vault-name Personal --item-title github-personal --field username)"
        github_pers_pat="$(pass-cli item view --vault-name Personal --item-title github-personal --field personal-access-token)"

        cat > "$authinfo_tmp" <<EOF
machine api.github.com login ${github_pers_user}^forge password $github_pers_pat
EOF

        rage --encrypt \
             "$@" \
             --output "$authinfo_age_tmp" \
             "$authinfo_tmp"

        chmod 600 "$authinfo_age_tmp"
        mv -- "$authinfo_age_tmp" "$AUTHINFO_FILE"
    )

    setup_log_info "Created Authinfo file."
fi


setup_log_info "Creating mail directories..."

MAILDIR="${MAILDIR:-$XDG_DATA_HOME/mail}"

install -d -m 700 -- \
        "$MAILDIR" \
        "$MAILDIR/matthiasmeijers-proton" \
        "$MAILDIR/personal-mmeijers" \
        "$MAILDIR/kernel-mmeijers" \
        "$MAILDIR/kem-mmeijers" \
        "$MAILDIR/mmeijersres-protonmail" \
        "$MAILDIR/research-mmeijers" \
        "$MAILDIR/teaching-mmeijers" \
        "$MAILDIR/host-mmeijers" \
        "$MAILDIR/dump-mmeijers"

setup_log_info "Created mail directories."

setup_log_info "Synchronizing mail directories..."

sudo zypper --non-interactive --no-color install isync maildir-utils
(cd -- "$DOTS_DIR" && stow isync)

"$REPLACE_PLACEHOLDER" XDG_CONFIG_HOME "$XDG_CONFIG_HOME" \
    "$XDG_CONFIG_HOME/isyncrc-temp" \
    "$XDG_CONFIG_HOME/isyncrc"

"$REPLACE_PLACEHOLDER" MAILDIR "$MAILDIR" \
    "$XDG_CONFIG_HOME/isyncrc"

if ! command -v mbsync >/dev/null 2>&1; then
    setup_log_die "mbsync is not available after installing isync."
fi

mbsync --all --verbose

setup_log_info "Synchronized mail directories."


setup_log_info "Setting up Proton Bridge headless autostart..."

mkdir -p -- "$XDG_CONFIG_HOME/autostart"
rm -f -- "$XDG_CONFIG_HOME/autostart/Proton Mail Bridge.desktop"

protonmail_bridge_exec="$(command -v protonmail-bridge)"
cat > "$XDG_CONFIG_HOME/autostart/protonmail-bridge-headless.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Proton Mail Bridge (Headless)
Comment=Run Proton Mail Bridge without its graphical interface
Exec="$protonmail_bridge_exec" "--noninteractive"
Terminal=false
StartupNotify=false
EOF

setup_log_info "Set up Proton Bridge headless autostart."


setup_log_info "Initializing mail environment (mu)..."

cat > "$XDG_CONFIG_HOME/systemd/user/environment/mail.conf" <<EOF
MAILDIR="$MAILDIR"
EOF

mu init --maildir="$MAILDIR"
mu index

setup_log_info "Initializing mail environment (mu)."


setup_log_info "Installing spellchecker and dictionaries..."

sudo zypper --non-interactive --no-color install \
     hunspell \
     'myspell-en*' \
     'myspell-nl*' \
     'myspell-de*' \
     'myspell-fr*' \
     'myspell-es*'

setup_log_info "Installed spellchecker and dictionaries."


setup_log_info "Installing editor (Emacs)..."

sudo zypper --non-interactive --no-color install emacs emacs-x11 mu4e pinentry-emacs

emacs_x11_exec="$(command -v emacs-x11)"
ln -sf -- "$emacs_x11_exec" "$XDG_BIN_HOME/emacs"

(cd -- "$DOTS_DIR" && stow emacs)

cat > "$XDG_CONFIG_HOME/systemd/user/emacs-x11.service" <<EOF
[Unit]
Description=Emacs text editor
Documentation=info:emacs man:emacs(1) https://gnu.org/software/emacs/

Conflicts=emacs.service

PartOf=graphical-session.target

[Service]
Type=notify
ExecStart="$emacs_x11_exec" --fg-daemon

SuccessExitStatus=15
Restart=on-failure

EnvironmentFile=$XDG_CONFIG_HOME/systemd/user/environment/authinfo.conf
EnvironmentFile=$XDG_CONFIG_HOME/systemd/user/environment/mail.conf

[Install]
WantedBy=graphical-session.target
EOF

emacsclient_exec="$(command -v emacsclient)"
cat > "$XDG_CONFIG_HOME/systemd/user/emacs-x11-primer.service" <<EOF
[Unit]
Description=Prime Emacs X11 graphical initialization

Requires=emacs-x11.service
After=emacs-x11.service graphical-session.target
Requisite=graphical-session.target

[Service]
Type=oneshot

ExecStart="$emacsclient_exec" --alternate-editor=false --display "\$DISPLAY" --quiet --suppress-output --no-wait --create-frame --frame-parameters '((name . "emacs-x11-primer") (visibility . nil) (a-primer . t))'
ExecStart="$emacsclient_exec" --alternate-editor=false --quiet --suppress-output --eval '(when-let ((frame (seq-find (lambda (frame) (frame-parameter frame (quote a-primer))) (frame-list)))) (delete-frame frame t))'
EOF

systemctl --user daemon-reload
systemctl --user enable emacs-x11.service

if systemctl --user cat niri.service >/dev/null 2>&1; then
    systemctl --user add-wants niri.service emacs-x11-primer.service
fi

setup_log_info "Syncing ORG data..."
# clone_or_update 'git@github-personal:mmctl/org.git' "$XDG_DATA_HOME/org"
proton-drive filesystem download -c skip "$ORG_DIR_REMOTE" "$ORG_PARENT_DIR_LOCAL"
setup_log_info "Synced ORG data."

setup_log_info "Setting default file associations..."

mkdir -p -- "$XDG_DATA_HOME/applications"

cat > "$XDG_DATA_HOME/applications/emacsclient-x11.desktop" <<'EOF'
[Desktop Entry]
Name=Emacsclient
Comment=Run Emacsclient, starting a server if none is currently running
Exec=emacsclient-x11 --create-frame %F
Icon=emacs
Categories=Development;TextEditor;Utility;
MimeType=text/plain;text/english;text/x-c;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-shellscript;text/x-tex;text/markdown;application/x-shellscript;application/json;application/xml;
NoDisplay=true
Terminal=false
Type=Application
EOF

cat > "$XDG_DATA_HOME/applications/emacsclient-x11-mail.desktop" <<'EOF'
[Desktop Entry]
Name=Emacsclient Mail
Comment=Compose mail with Emacsclient
Categories=Network;Email;
Exec=emacsclient-x11 --create-frame --eval '(message-mailto "%u")'
Icon=emacs
MimeType=x-scheme-handler/mailto;
NoDisplay=true
Terminal=false
Type=Application
EOF

update-desktop-database "$XDG_DATA_HOME/applications"

xdg-mime default emacsclient-x11.desktop text/plain
xdg-mime default emacsclient-x11-mail.desktop x-scheme-handler/mailto

setup_log_info "Set default file associations."

setup_log_info "Installed editor (Emacs)."


setup_log_info "Cleaning up..."
rm -f -- "$HOME/.emacs"
rm -rf -- "$HOME/.emacs.d"
setup_log_info "Cleaned up."


setup_log_action "Manual checkpoint:"
setup_log_action "  Run non-daemon Emacs (emacs), load the install script, and wait for native compilation to finish:"
setup_log_action "    (load \"$XDG_DATA_HOME/emacs/install/install-entry.el\")"
setup_log_action "  Add any additional credential entries in $AUTHINFO_FILE, e.g., access tokens for other forge accounts."
setup_log_action "  Reboot."
