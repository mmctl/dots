#!/usr/bin/env sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
    printf "error: do not run this as root; run it as the target regular user for setup." >&2
    exit 1
fi

if [ "$#" -ne 1 ]; then
    printf '%s\n' "usage: $0 script" >&2
    exit 2
fi

script_path=$1

if [ ! -x "$script_path" ]; then
    printf '%s\n' "error: script not found or not executable: $script_path" >&2
    exit 1
fi

if command -v script >/dev/null 2>&1; then
    printf '%s\n' "error: required command not found: script" >&2
    exit 1
fi

script_name=$(basename "$script_path")
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/setup"
log_file="$log_dir/$script_name-$(date '+%Y%m%d-%H%M%S').log"

install -d -m 700 -- "$log_dir"
touch "$log_file" || exit 1
chmod 600 -- "$log_file" || exit 1

{
    printf "[%s] [INFO] Executing %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$script_path"
    printf "[%s] [INFO] Logging to %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$log_file"

    "$script_path"
    status=$?

    if [ "$status" -eq 0 ]; then
        printf "[%s] [INFO] Executed %s\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$script_path"
    else
        printf "[%s] [ERROR] Failed with exit status %s: %s\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$status" "$script_path"
    fi

    printf "[%s] [INFO] Logged to %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$log_file"

    exit "$status"
} 2>&1 | tee -a "$log_file"
