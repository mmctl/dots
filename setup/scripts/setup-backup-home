#!/usr/bin/env sh
set -eu

# Setup utilities
script_dir="$(dirname -- "$(realpath "$0")")"
. "$script_dir/utils"


if [ "$(id -u)" -eq 0 ]; then
    setup_log_die "Run this script as the target regular user, not as root."
fi

if ! command -v zypper >/dev/null 2>&1; then
    setup_log_die "zypper is not available; this script is intended for openSUSE."
fi


setup_log_info "This script needs sudo for system configuration."
sudo -v || setup_log_die "Failed to obtain valid sudo credentials."


# Input processing
setup_log_info "Processing input..."
if [ "$#" -ne 1 ]; then
    cat <<EOF
Usage:
  $(basename "$0") FILESYSTEM_UUID

Example:
  $(basename "$0") 01234567-89ab-cdef-0123-456789abcdef
EOF
    setup_log_die "Expected exactly one argument: the filesystem UUID of the backup medium."
fi

backup_fs_uuid=$1
backup_device="/dev/disk/by-uuid/$backup_fs_uuid"

if [ ! -e "$backup_device" ]; then
    setup_log_die "No block device found for filesystem UUID: $backup_fs_uuid"
fi

if ! backup_fs_type="$(sudo blkid -o value -s TYPE "$backup_device")"; then
    setup_log_die "Could not determine filesystem type for UUID: $backup_fs_uuid"
fi

if [ -z "$backup_fs_type" ]; then
    setup_log_die "No filesystem found for UUID: $backup_fs_uuid"
fi

setup_log_info "Backup filesystem UUID (device): $backup_fs_uuid ($backup_device)"
setup_log_info "Backup filesystem type: $backup_fs_type"
setup_log_info "Processed input."


if ! command -v rbw >/dev/null 2>&1; then
    setup_log_die "Password manager (rbw) not available. Run the security setup first."
fi

if ! command -v systemd-id128 >/dev/null 2>&1; then
    setup_log_die "systemd-id128 is not available; check your systemd installation."
fi

if ! command -v jq >/dev/null 2>&1; then
    setup_log_info "jq is not installed. Installing..."
    sudo zypper --non-interactive --no-color install jq
    setup_log_info "Installed jq."
fi

if ! command -v notify-send >/dev/null 2>&1; then
    setup_log_info "libnotify-tools is not installed. Installing..."
    sudo zypper --non-interactive --no-color install libnotify-tools
    setup_log_info "Installed libnotify-tools."
fi


XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DOTS_DIR="${DOTS_DIR:-$XDG_DATA_HOME/dots}"

if [ ! -d "$DOTS_DIR" ]; then
    setup_log_die "dotfiles directory not found: $DOTS_DIR"
fi

REPLACE_PLACEHOLDER="${REPLACE_PLACEHOLDER:-$DOTS_DIR/setup/scripts/replace-placeholder}"

if [ ! -x "$REPLACE_PLACEHOLDER" ]; then
    setup_log_die "replace-placeholder script not found or not executable: $REPLACE_PLACEHOLDER"
fi

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
LIBEXEC_DIR="${LIBEXEC_DIR:-$HOME/.local/libexec}"

installation_id=$(systemd-id128 new)
installation_timestamp=$(date -u '+%Y%m%dT%H%M%SZ')
installation_dirname="$installation_timestamp-$installation_id"

MACHINE_LABEL="${MACHINE_LABEL:-laptop-lenovo-thinkpad-t14-gen2}"
BACKUP_MOUNTPOINT="${BACKUP_MOUNTPOINT:-/mnt/backup-primary}"
BACKUP_ROOT="${BACKUP_ROOT:-$BACKUP_MOUNTPOINT/personal/$MACHINE_LABEL}"

### Doesn't this require the filesystem to be mounted already?
### We don't assume this, do we?
if [ ! -d "$BACKUP_ROOT" ]; then
    setup_log_die "Expected machine backup root does not exist: $BACKUP_ROOT"
fi

if [ ! -w "$BACKUP_ROOT" ]; then
    setup_log_die "Expected machine backup root is not writable by $USER: $BACKUP_ROOT"
fi

installation_root="$BACKUP_ROOT/$installation_dirname"
staging_root="$BACKUP_ROOT/.$installation_dirname.setup"

if [ -e "$installation_root" ] || [ -e "$staging_root" ]; then
    setup_log_die "Generated installation path already exists; aborting: $installation_root"
fi

INSTALLATION_METADATA_FILE="$installation_root/metadata"
LUKS_BACKUP_DIR="$installation_root/luks"
RESTIC_REPOSITORY="$installation_root/home"

RESTIC_CONFIG_DIR="${RESTIC_CONFIG_DIR:-$XDG_CONFIG_HOME/restic}"
RESTIC_HOME_CONFIG_FILE="${RESTIC_HOME_CONFIG_FILE:-$RESTIC_CONFIG_DIR/backup-home.conf}"
RESTIC_HOME_EXCLUDE_FILE="${RESTIC_HOME_EXCLUDE_FILE:-$RESTIC_CONFIG_DIR/excludes-backup-home.conf}"

RESTIC_PASSWORD_ITEM="${RESTIC_PASSWORD_ITEM:-restic-backup-home}"
RESTIC_PASSWORD_FOLDER="${RESTIC_PASSWORD_FOLDER:-backups-and-recovery}"
RESTIC_PASSWORD_COMMAND="${RESTIC_PASSWORD_COMMAND:-rbw get $RESTIC_PASSWORD_ITEM}"

RESTIC_KEEP_DAILY="${RESTIC_KEEP_DAILY:-7}"
RESTIC_KEEP_WEEKLY="${RESTIC_KEEP_WEEKLY:-4}"
RESTIC_KEEP_MONTHLY="${RESTIC_KEEP_MONTHLY:-12}"
RESTIC_KEEP_YEARLY="${RESTIC_KEEP_YEARLY:-5}"


setup_log_info "Installing backup software (Restic)..."
sudo zypper --non-interactive --no-color install restic
setup_log_info "Installed backup software (Restic)."


mounted_here=0
tmp_config=

cleanup()
{
    status=$?
    trap - EXIT HUP INT TERM

    if [ -n "$tmp_config" ] && [ -e "$tmp_config" ]; then
        rm -f -- "$tmp_config"
    fi

    if [ -d "$staging_root" ]; then
        rm -rf -- "$staging_root"
    fi

    if [ "$mounted_here" -eq 1 ] &&
       mountpoint -q "$BACKUP_MOUNTPOINT"; then
        sudo umount "$BACKUP_MOUNTPOINT" || status=1
    fi

    exit "$status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM


if mountpoint -q "$BACKUP_MOUNTPOINT"; then
    confirm_mounted "$backup_fs_uuid" "$BACKUP_MOUNTPOINT"
else
    setup_log_info "Mounting backup filesystem..."

    sudo mount \
        -t "$backup_fs_type" \
        -o nosuid,nodev,noexec \
        "$backup_device" \
        "$BACKUP_MOUNTPOINT"

    mounted_here=1

    setup_log_info "Mounted backup filesystem."
fi


setup_log_info "Setting up staging area..."
install -d -m 700 -- "$staging_root"
install -d -m 700 -- "$staging_root/home" "$staging_root/luks"
setup_log_info "Set up staging area."


if rbw get "$RESTIC_PASSWORD_ITEM" >/dev/null 2>&1; then
    setup_log_info "Entry $RESTIC_PASSWORD_ITEM already exists in passowrd manager; skipping creation."
else
    setup_log_info "Generating entry in password manager (folder: $RESTIC_PASSWORD_FOLDER, name: $RESTIC_PASSWORD_ITEM)..."
    rbw generate --folder "$RESTIC_PASSWORD_FOLDER" 14 "$RESTIC_PASSWORD_ITEM" "$USER" >/dev/null 2>&1
    setup_log_info "Generated entry in password manager (folder: $RESTIC_PASSWORD_FOLDER, name: $RESTIC_PASSWORD_ITEM)."
fi



setup_log_info "Initializing Restic home-backup repository in staging area..."
restic --repo "$staging_root/home" \
       --password-command "$RESTIC_PASSWORD_COMMAND" \
       init
setup_log_info "Initialized Restic home-backup repository in staging area."

### Let's assume jq here, I added a check for it above
restic_repository_id=$(
    restic \
        --repo "$staging_root/home" \
        --password-command "$RESTIC_PASSWORD_COMMAND" \
        cat config |
    sed -n \
        's/^[[:space:]]*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
    head -n 1
)

if [ -z "$restic_repository_id" ]; then
    setup_log_die "Initialized Restic repository, but could not read its repository ID."
fi

### I don't care if hostname or operating system are null
setup_log_info "Writing metadata file in staging area..."
cat >"$staging_root/metadata" <<EOF
Machine label: $MACHINE_LABEL
Installation ID: $installation_id
Created at (UTC): $installation_timestamp
Hostname at setup: $(hostnamectl --json=short | jq -r .HostName)
Operating system: $(hostnamectl --json=short | jq -r .OperatingSystemPrettyName)
Architecture: $(uname -m)
Backup filesystem UUID: $backup_fs_uuid
Home source: $HOME
Home repository: $RESTIC_REPOSITORY
Restic repository ID: $restic_repository_id
LUKS backup directory: $LUKS_BACKUP_DIR
EOF
setup_log_info "Wrote metadata file in staging area."

setup_log_info "Installing staging area to installation root..."
mv -- "$staging_root" "$installation_root"
setup_log_info "Installed staging area to installation root."


setup_log_info "Stowing (portable) Restic configuration and assets..."

(cd -- "$DOTS_DIR" && stow restic)

"$REPLACE_PLACEHOLDER" XDG_DATA_HOME "$XDG_DATA_HOME" \
    "$XDG_CONFIG_HOME/restic/excludes-backup-home-temp.conf" \
    "$XDG_CONFIG_HOME/restic/excludes-backup-home.conf"
"$REPLACE_PLACEHOLDER" HOME "$HOME" \
    "$XDG_CONFIG_HOME/restic/excludes-backup-home.conf"

"$REPLACE_PLACEHOLDER" LIBEXEC_DIR "$LIBEXEC_DIR" \
    "$XDG_CONFIG_HOME/systemd/user/restic-backup-home-temp.service" \
    "$XDG_CONFIG_HOME/systemd/user/restic-backup-home.service"

setup_log_info "Stowed (portable) Restic configuration and assets."


setup_log_info "Writing Restic configuration ($RESTIC_HOME_CONFIG_FILE)..."

tmp_config="$(mktemp "$RESTIC_HOME_CONFIG_FILE.tmp.XXXXXX")"

{
    cat >"$tmp_config" <<EOF
BACKUP_FS_UUID='$backup_fs_uuid'
BACKUP_MOUNTPOINT='$BACKUP_MOUNTPOINT'
BACKUP_INSTALLATION_ROOT='$installation_root'

RESTIC_BACKUP_SOURCE='$HOME'
RESTIC_REPOSITORY='$RESTIC_REPOSITORY'
RESTIC_EXCLUDE_FILE='$RESTIC_HOME_EXCLUDE_FILE'
RESTIC_EXPECTED_REPOSITORY_ID='$restic_repository_id'

RESTIC_PASSWORD_COMMAND='$RESTIC_PASSWORD_COMMAND'

RESTIC_KEEP_DAILY='$RESTIC_KEEP_DAILY'
RESTIC_KEEP_WEEKLY='$RESTIC_KEEP_WEEKLY'
RESTIC_KEEP_MONTHLY='$RESTIC_KEEP_MONTHLY'
RESTIC_KEEP_YEARLY='$RESTIC_KEEP_YEARLY'
EOF
} > "$tmp_config"

chmod 600 -- "$tmp_config"
mv -f -- "$tmp_config" "$RESTIC_HOME_CONFIG_FILE"
tmp_config=

setup_log_info "Wrote Restic configuration ($RESTIC_HOME_CONFIG_FILE)."


if [ "$mounted_here" -eq 1 ]; then
    setup_log_info "Unmounting backup filesystem..."
    sudo umount "$BACKUP_MOUNTPOINT"
    setup_log_info "Unmounted backup filesystem."
fi


setup_log_info "Enabling Restic home-backup systemd (user) timer..."
systemctl --user daemon-reload
systemctl --user enable restic-backup-home.timer
setup_log_info "Enabled Restic home-backup systemd (user) timer."


case "$backup_fs_type" in
    btrfs|xfs)
        fstab_passno=0
        ;;
    *)
        fstab_passno=2
        ;;
esac

fstab_line="UUID=$backup_fs_uuid $BACKUP_MOUNTPOINT $backup_fs_type noauto,user,nofail,nosuid,nodev,noexec 0 $fstab_passno"

setup_log_action "Manual checkpoint:"
setup_log_action "  Check /etc/fstab for an existing entry for either:"
setup_log_action "    UUID=$backup_fs_uuid"
setup_log_action "    $BACKUP_MOUNTPOINT"
setup_log_action "  If no such entry exists, add:"
setup_log_action "    $fstab_line"
setup_log_action "  Then reload systemd's view of fstab:"
setup_log_action "    sudo systemctl daemon-reload"
setup_log_action "  Test mounting as the regular user:"
setup_log_action "    mount '$BACKUP_MOUNTPOINT'"
setup_log_action "    umount '$BACKUP_MOUNTPOINT'"
setup_log_action "  Optionally, run one backup immediately:"
setup_log_action "    systemctl --user start restic-backup-home.service"
