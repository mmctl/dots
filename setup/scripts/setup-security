#     setup_log_info "Created Authinfo file."
# fi


setup_log_action "Manual checkpoint:"
setup_log_action "  If fingerprint authentication has been enabled, enroll fingerprint(s):"
setup_log_action "    fprintd-enroll -f right-index-finger \"$USER\""
setup_log_action "    fprintd-verify -f right-index-finger \"$USER\""
setup_log_action "    fprintd-enroll -f left-index-finger \"$USER\""
setup_log_action "    fprintd-verify -f left-index-finger \"$USER\""
setup_log_action "  Extract SSH identity files from hardware keys:"
setup_log_action "    cd -- $HOME/.ssh"
setup_log_action "    ssh-keygen -K"
setup_log_action "  Rename and delete the extracted files as appropriate for machine (see $HOME/.ssh/config for names)."
setup_log_action "  Extract age identity files from hardware keys:"
setup_log_action "    cd -- $XDG_CONFIG_HOME/age/identities"
setup_log_action "    age-yubikey-plugin -i"
setup_log_action "  Store each relevant identity as appropriate for machine."
setup_log_action "  See $XDG_CONFIG_HOME/age/recipients/ for names of corresponding recipient files."
setup_log_action "  Each recipient file expects a corresponding identity file with the same name, but with an \"identity\" extension."
setup_log_action "  Reboot."
