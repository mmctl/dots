#!/usr/bin/env sh
set -eu

if [ "$(id -u)" -eq 0 ] ; then
   echo "ERROR: Run this script as the target regular user, not as root." >&2
   exit 1
fi

if ! command -v stow >/dev/null 2>&1; then
  echo "ERROR: stow is not installed. Install it first:" >&2
  echo "       sudo zypper install stow" >&2
  exit 1
fi

echo "This script needs sudo for system configuration."
sudo -v

DOTS_DIR="${DOTS_DIR:-$XDG_DATA_HOME/dots}"

if [ ! -d "$DOTS_DIR" ]; then
  echo "ERROR: dotfiles directory not found: $DOTS_DIR" >&2
  exit 1
fi


install -d -m 700 \
  "$HOME/.ssh" \
  "$HOME/.gnupg"

(cd $DOTS_DIR && stow ssh gpg)

ssh-keygen -t ed25519 -C "${USER}-personal@$(hostname)-$(date +%Y%m%d)" -f "$HOME/.ssh/${USER}_ed25519_personal"
ssh-keygen -t ed25519 -C "${USER}-work@$(hostname)-$(date +%Y%m%d)" -f "$HOME/.ssh/${USER}_ed25519_work"

sudo zypper install pinentry
cargo install --locked rbw
cd "$XDG_DATA_HOME/dots" && stow rbw
