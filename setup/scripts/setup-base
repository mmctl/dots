#!/usr/bin/env sh
set -eu

# Setup utilities
script_dir="$(dirname -- "$(realpath "$0")")"
. "$script_dir/utils"


if [ "$(id -u)" -eq 0 ]; then
    setup_log_die "Run this script as the target regular user, not as root."
fi

if ! command -v zypper >/dev/null 2>&1; then
    setup_log_die "zypper is not available; this script is intended for openSUSE."
fi

setup_log_info "This script needs sudo for system configuration."
sudo -v || setup_log_die "Failed to obtain valid sudo credentials."


for bcmd in git curl gpg2 stow; do
    if ! command -v "$bcmd" >/dev/null 2>&1; then
        setup_log_info "$bcmd is not installed. Installing..."
        sudo zypper --non-interactive --no-color install "$bcmd"
        setup_log_info "Installed $bcmd."
    fi
done

XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DOTS_DIR="${DOTS_DIR:-$XDG_DATA_HOME/dots}"

if [ ! -d "$DOTS_DIR" ]; then
    setup_log_die "dotfiles directory not found: $DOTS_DIR"
fi


setup_log_info "Stowing .profile..."
rm -f -- "$HOME/.profile"

(cd -- "$DOTS_DIR" && stow base)
. "$HOME/.profile"

setup_log_info "Stowed .profile."


setup_log_info "Creating XDG directories and setting user-dirs..."

XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"

mkdir -p -- \
        "$XDG_CACHE_HOME" \
        "$XDG_CONFIG_HOME" \
        "$XDG_DATA_HOME" \
        "$XDG_STATE_HOME" \
        "$XDG_BIN_HOME"

rm -f -- "$XDG_CONFIG_HOME/user-dirs.dirs"
(cd -- "$DOTS_DIR" && stow xdg)

setup_log_info "Created XDG directories and set user-dirs."


setup_log_info "Adding Packman Essentials repository..."

packman_essentials_url='https://ftp.gwdg.de/pub/linux/misc/packman/suse/openSUSE_Tumbleweed/Essentials/'
packman_essentials_alias='packman-essentials'

if sudo zypper --non-interactive --no-color lr "$packman_essentials_alias" >/dev/null 2>&1; then
    setup_log_info "Repository '${packman_essentials_alias}' already exists; skipping."
else
    packman_essentials_key_url='https://ftp.gwdg.de/pub/linux/misc/packman/suse/openSUSE_Tumbleweed/Essentials/repodata/repomd.xml.key'
    packman_essentials_key_exp='F8875B880D518B6B8C530D1345A1D0671ABD1AFB'

    setup_log_info "Handling Packman Essentials repository GPG key..."
    if ! download_and_import_rpm_key "$packman_essentials_key_url" "$packman_essentials_key_exp"; then
       setup_log_die "Failed to download, verify, and import Packman Essentials repository GPG key."
    fi
    setup_log_info "Handled Packman Essentials repository GPG key."

    sudo zypper --non-interactive --no-color addrepo -cfp 90 "$packman_essentials_url" "$packman_essentials_alias"
    setup_log_info "Added Packman Essentials repository."

    setup_log_info "Refreshing Packman Essentials repository..."
    sudo zypper --non-interactive --no-color --gpg-auto-import-keys refresh "$packman_essentials_alias"
    setup_log_info "Refreshed Packman Essentials repository."
fi



setup_log_info "Installing codecs from Packman Essentials repository..."

sudo zypper --non-interactive --no-color install --allow-vendor-change --from "$packman_essentials_alias" \
     ffmpeg \
     gstreamer-plugins-good \
     gstreamer-plugins-bad \
     gstreamer-plugins-ugly \
     gstreamer-plugins-libav \
     libavcodec

setup_log_info "Installed codecs from Packman Essentials repository."


setup_log_info "Updating packages..."

sudo zypper --non-interactive --no-color dup

setup_log_info "Updated packages."

setup_log_action "Manual checkpoint:"
setup_log_action "  Reboot."
