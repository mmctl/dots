#!/usr/bin/env sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
    echo "ERROR: Run this script as the target regular user, not as root." >&2
    exit 1
fi

if ! command -v zypper >/dev/null 2>&1; then
    echo "ERROR: zypper is not available; this script is intended for openSUSE." >&2
    exit 1
fi

if ! command -v stow >/dev/null 2>&1; then
    echo "ERROR: stow is not installed. Install it first:" >&2
    echo "       sudo zypper install stow" >&2
    exit 1
fi

echo "This script needs sudo for system configuration."
sudo -v

PACKMAN_ESSENTIALS_URL="https://ftp.gwdg.de/pub/linux/misc/packman/suse/openSUSE_Tumbleweed/Essentials/"
PACKMAN_ESSENTIALS_ALIAS="packman-essentials"

XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DOTS_DIR="${DOTS_DIR:-$XDG_DATA_HOME/dots}"

if [ ! -d "$DOTS_DIR" ]; then
    echo "ERROR: dotfiles directory not found: $DOTS_DIR" >&2
    exit 1
fi


echo "Stowing .profile..."
rm -f -- "$HOME/.profile"

(cd "$DOTS_DIR" && stow base)
. "$HOME/.profile"

echo "Stowed .profile."


echo "Creating XDG directories and setting user-dirs..."

XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"

install -d -m 700 \
        "$XDG_CACHE_HOME" \
        "$XDG_CONFIG_HOME" \
        "$XDG_DATA_HOME" \
        "$XDG_STATE_HOME" \
        "$XDG_BIN_HOME"

rm -f -- "$XDG_CONFIG_HOME/user-dirs.dirs"
(cd "$DOTS_DIR" && stow xdg)

echo "Created XDG directories and set user-dirs."


echo "Creating PARA directories..."

install -d -m 700 \
        "$HOME/projects" \
        "$HOME/areas" \
        "$HOME/resources" \
        "$HOME/archives"

echo "Created PARA directories."


echo "Adding Packman Essentials repository..."

if sudo zypper lr "$PACKMAN_ESSENTIALS_ALIAS" >/dev/null 2>&1; then
    echo "Repository '$PACKMAN_ESSENTIALS_ALIAS' already exists; skipping."
else
    sudo zypper addrepo -cfp 90 "$PACKMAN_ESSENTIALS_URL" "$PACKMAN_ESSENTIALS_ALIAS"
    echo "Added Packman Essentials repository."
fi


echo "Refreshing repositories..."
echo "Verify the Packman Essentials key fingerprint when prompted:"
echo "F887 5B88 0D51 8B6B 8C53 0D13 45A1 D067 1ABD 1AFB"

sudo zypper refresh

echo "Refreshed repositories"


echo "Installing codecs from Packman Essentials repository..."

sudo zypper install --allow-vendor-change --from "$PACKMAN_ESSENTIALS_ALIAS" \
     ffmpeg \
     gstreamer-plugins-good \
     gstreamer-plugins-bad \
     gstreamer-plugins-ugly \
     gstreamer-plugins-libav \
     libavcodec

echo "Installed codecs from Packman Essentials repository."


echo "Updating packages..."

sudo zypper dup

echo "Updated packages."

echo
echo "Manual checkpoint:"
echo "  Reboot before continuing with the setup."
