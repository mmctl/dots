#!/usr/bin/env sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
    echo "ERROR: Run this script as the target regular user, not as root." >&2
    exit 1
fi

if ! command -v zypper >/dev/null 2>&1; then
    echo "ERROR: zypper is not available; this script is intended for openSUSE." >&2
    exit 1
fi

echo "INFO: This script needs sudo for system configuration."
sudo -v


echo "INFO: Installing development/build essentials..."

sudo zypper install -y -t pattern devel_basis
sudo zypper install -y curl ca-certificates

echo "INFO: Installed development/build essentials."


echo "INFO: Sourcing existing Rust environment if present..."

CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"

if [ -f "$CARGO_HOME/env" ]; then
    . "$CARGO_HOME/env"
    echo "INFO: Sourced existing Rust environment."
else
    echo "INFO: Did not find existing Rust environment."
fi


echo "INFO: Installing or updating Rust toolchain..."

if command -v rustup >/dev/null 2>&1; then
    echo "INFO: rustup already installed; updating stable Rust toolchain..."
    rustup update stable
    echo "INFO: Updated stable Rust toolchain."
else
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
        sh -s -- -y --no-modify-path

    if [ -f "$CARGO_HOME/env" ]; then
        . "$CARGO_HOME/env"
    else
        echo "ERROR: Rust installer completed, but $CARGO_HOME/env was not created." >&2
        exit 1
    fi

    echo "INFO: Installed Rust toolchain."
fi
