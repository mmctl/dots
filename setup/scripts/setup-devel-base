#!/usr/bin/env sh
set -eu

# Setup utilities
script_dir="$(dirname -- "$(realpath "$0")")"
. "$script_dir/utils"


if [ "$(id -u)" -eq 0 ]; then
    setup_log_die "Run this script as the target regular user, not as root."
fi

if ! command -v zypper >/dev/null 2>&1; then
    setup_log_die "zypper is not available; this script is intended for openSUSE."
fi

setup_log_info "This script needs sudo for system configuration."
sudo -v || setup_log_die "Failed to obtain valid sudo credentials."


setup_log_info "Installing development/build essentials..."

sudo zypper --non-interactive --no-color install -t pattern devel_basis
sudo zypper --non-interactive --no-color install unzip curl ca-certificates cmake ninja meson gdb

setup_log_info "Installed development/build essentials."


setup_log_info "Sourcing existing Rust environment if present..."

export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"

if [ -f "$CARGO_HOME/env" ]; then
    . "$CARGO_HOME/env"
    setup_log_info "Sourced existing Rust environment."
fi


setup_log_info "Installing or updating stable Rust toolchain..."

if ! command -v rustup >/dev/null 2>&1; then
    setup_log_info "rustup is not installed. Installing..."
    sudo zypper --non-interactive --no-color install rustup
    setup_log_info "Installed rustup."
fi

rustup toolchain install stable
rustup default stable

setup_log_info "Installed or updated stable Rust toolchain."


setup_log_info "Stowing git..."

(cd -- "$DOTS_DIR" && stow git)

setup_log_info "Stowed git."


setup_log_action "Manual checkpoint:"
setup_log_action "  Ensure '${CARGO_HOME}/bin' is added to PATH"
