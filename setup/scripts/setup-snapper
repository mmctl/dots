#!/usr/bin/env sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
  echo "ERROR: Run this script as the target regular user, not as root." >&2
  exit 1
fi

echo "This script needs sudo for system configuration."
sudo -v

if sudo btrfs subvolume show /home >/dev/null 2>&1; then
  echo "/home is a BTRFS subvolume; configuring snapper config 'home'."

  if sudo snapper -c home get-config >/dev/null 2>&1; then
    echo "Snapper config 'home' already exists; leaving snapshot structure intact."
  else
    echo "Creating snapper config 'home' for /home."
    sudo snapper -c home create-config /home
  fi

  sudo snapper -c home set-config \
    "ALLOW_USERS=$USER" \
    NUMBER_CLEANUP=yes \
    NUMBER_LIMIT=25 \
    NUMBER_LIMIT_IMPORTANT=25 \
    TIMELINE_CREATE=yes \
    TIMELINE_CLEANUP=yes \
    TIMELINE_LIMIT_HOURLY=12 \
    TIMELINE_LIMIT_DAILY=12 \
    TIMELINE_LIMIT_WEEKLY=12 \
    TIMELINE_LIMIT_MONTHLY=4 \
    TIMELINE_LIMIT_YEARLY=0

  echo "Configured snapper for /home."
else
  echo "/home is not a BTRFS subvolume; skipping snapper config 'home'."
fi
