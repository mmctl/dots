#!/usr/bin/env sh
set -eu

# Setup logging
script_dir="$(dirname -- "$(realpath "$0")")"
. "$script_dir/logging-utils"


if [ "$(id -u)" -eq 0 ]; then
    setup_log_die "Run this script as the target regular user, not as root."
fi

setup_log_info "This script needs sudo for system configuration."
sudo -v || setup_log_die "Failed to obtain valid sudo credentials."

if sudo btrfs subvolume show /home >/dev/null 2>&1; then
    setup_log_info "/home is a BTRFS subvolume; configuring snapper config 'home'..."

    if sudo snapper -c home get-config >/dev/null 2>&1; then
        setup_log_info "Snapper config 'home' already exists; leaving snapshot structure intact."
    else
        setup_log_info "Creating snapper config 'home' for /home..."
        sudo snapper -c home create-config /home
        setup_log_info "Created snapper config 'home' for /home."
    fi

    sudo snapper -c home set-config \
         "ALLOW_USERS=$USER" \
         NUMBER_CLEANUP=yes \
         NUMBER_LIMIT=25 \
         NUMBER_LIMIT_IMPORTANT=25 \
         TIMELINE_CREATE=yes \
         TIMELINE_CLEANUP=yes \
         TIMELINE_LIMIT_HOURLY=12 \
         TIMELINE_LIMIT_DAILY=12 \
         TIMELINE_LIMIT_WEEKLY=12 \
         TIMELINE_LIMIT_MONTHLY=4 \
         TIMELINE_LIMIT_YEARLY=0

    setup_log_info "Configured snapper for /home."
else
    setup_log_info "/home is not a BTRFS subvolume; skipping snapper config 'home'."
fi
