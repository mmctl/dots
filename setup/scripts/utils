# Source this file; do not execute it.

# Logging
setup_log_timestamp() {
    date '+%Y-%m-%d %H:%M:%S'
}

setup_log() {
    level=$1
    shift

    printf '[%s] [%s] %s\n' "$(setup_log_timestamp)" "$level" "$*"
}

setup_log_info() {
    setup_log INFO "$@"
}

setup_log_action() {
    setup_log ACTION "$@"
}

setup_log_warn() {
    setup_log WARNING "$@"
}

setup_log_error() {
    setup_log ERROR "$@"
}

setup_log_die() {
    setup_log_error "$@"
    exit 1
}


# Git
clone_or_update() {
    recurse=0

    case ${1:-} in
        --recurse-submodules)
            recurse=1
            shift
            ;;
    esac

    if [ "$#" -ne 2 ]; then
        setup_log_die "clone_or_update: expected [--recurse-submodules] REPO DEST"
    fi

    repo=$1
    dest=$2

    if [ -d "$dest/.git" ]; then
        setup_log_info "Updating repository '$dest'..."
        git -C "$dest" pull --ff-only

        if [ "$recurse" -eq 1 ]; then
            setup_log_info "Updating submodules in '$dest'..."
            git -C "$dest" submodule update --init --recursive
            setup_log_info "Updated submodules in '$dest'."
        fi
        setup_log_info "Updated repository '$dest'."
    elif [ -e "$dest" ]; then
        setup_log_die "Destination '$dest' exists but is not a Git repository."
    else
        if [ "$recurse" -eq 1 ]; then
            setup_log_info "Cloning repository '$repo' with submodules into '$dest'..."
            git clone --recurse-submodules "$repo" "$dest"
            setup_log_info "Cloned repository '$repo' with submodules into '$dest'."
        else
            setup_log_info "Cloning repository '$repo' into '$dest'..."
            git clone "$repo" "$dest"
            setup_log_info "Cloned repository '$repo' into '$dest'."
        fi
    fi
}


# GPG
normalize_fingerprint() {
    printf '%s' "$1" |
        tr -d '[:space:]' |
        tr '[:lower:]' '[:upper:]'
}

key_fingerprint() {(
    key_file=$1

    tmpdir=$(mktemp -d) || exit 1
    trap 'rm -rf -- "$tmpdir"' EXIT HUP INT TERM

    gnupg_home="$tmpdir/gnupg"
    install -d -m 700 -- "$gnupg_home"

    key_with_colons="$tmpdir/key.colons"

    if ! GNUPGHOME="$gnupg_home" gpg --batch --quiet --show-keys --with-colons "$key_file" > "$key_with_colons"; then
      exit 1
    fi

    awk --field-separator=: '
        $1 == "fpr" {
            print toupper($10)
            found = 1
            exit
        }

        END {
            if (!found)
                 exit 1
       }
    ' "$key_with_colons"

)}

verify_key_file() {
    key_file=$1
    expected_fpr=$(normalize_fingerprint "$2")

    if ! actual_fpr=$(key_fingerprint "$key_file"); then
        setup_log_die "Could not read GPG fingerprint from: '%s'" "$key_file"
    fi

    actual_fpr=$(normalize_fingerprint "$actual_fpr")

    if [ "$actual_fpr" != "$expected_fpr" ]; then
       setup_log_error 'Unexpected key fingerprint:'
       setup_log_error '   File: %s' "$key_file"
       setup_log_error '   Expected: %s' "$expected_fpr"
       setup_log_error '   Actual:   %s' "$actual_fpr"
       exit 1
    fi

    setup_log_info "Successfully verified key file '$key_file'."
}
