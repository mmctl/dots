# Source this file; do not execute it.

# Logging
setup_log_timestamp() {
    date '+%Y-%m-%d %H:%M:%S'
}

setup_log() {
    level=$1
    shift

    printf '[%s] [%s] %s\n' "$(setup_log_timestamp)" "$level" "$*"
}

setup_log_info() {
    setup_log INFO "$@"
}

setup_log_action() {
    setup_log ACTION "$@"
}

setup_log_warn() {
    setup_log WARNING "$@"
}

setup_log_error() {
    setup_log ERROR "$@"
}

setup_log_die() {
    setup_log_error "$@"
    exit 1
}


# Git
clone_or_update() {
    recurse=0

    case ${1:-} in
        --recurse-submodules)
            recurse=1
            shift
            ;;
    esac

    if [ "$#" -ne 2 ]; then
        setup_log_error "clone_or_update: expected [--recurse-submodules] REPO DEST"
        return 2
    fi

    repo=$1
    dest=$2

    if [ -d "$dest/.git" ]; then
        setup_log_info "Updating repository '$dest'..."
        git -C "$dest" pull --ff-only

        if [ "$recurse" -eq 1 ]; then
            setup_log_info "Updating submodules in '$dest'..."
            git -C "$dest" submodule update --init --recursive
            setup_log_info "Updated submodules in '$dest'."
        fi
        setup_log_info "Updated repository '$dest'."
    elif [ -e "$dest" ]; then
        setup_log_error "Destination '$dest' exists but is not a Git repository."
        return 1
    else
        if [ "$recurse" -eq 1 ]; then
            setup_log_info "Cloning repository '$repo' with submodules into '$dest'..."
            git clone --recurse-submodules "$repo" "$dest"
            setup_log_info "Cloned repository '$repo' with submodules into '$dest'."
        else
            setup_log_info "Cloning repository '$repo' into '$dest'..."
            git clone "$repo" "$dest"
            setup_log_info "Cloned repository '$repo' into '$dest'."
        fi
    fi
}


# GPG
normalize_fingerprint() {
    printf '%s' "$1" |
        tr -d '[:space:]' |
        tr '[:lower:]' '[:upper:]'
}

key_fingerprint() (
    key_file=$1

    tmpdir=$(mktemp -d) || exit 1
    trap 'rm -rf -- "$tmpdir"' EXIT HUP INT TERM

    gnupg_home="$tmpdir/gnupg"
    install -d -m 700 -- "$gnupg_home"

    key_with_colons="$tmpdir/key.colons"

    if ! GNUPGHOME="$gnupg_home" gpg --batch --quiet --show-keys --with-colons "$key_file" > "$key_with_colons"; then
      exit 1
    fi

    awk --field-separator=: '
        $1 == "fpr" {
            print toupper($10)
            found = 1
            exit
        }

        END {
            if (!found)
                 exit 1
       }
    ' "$key_with_colons"

)

verify_key_file() {
    key_file=$1
    fpr_exp=$(normalize_fingerprint "$2")
    
    setup_log_info "Verifying key file '$key_file' against '$fpr_exp'..."

    if ! fpr_act=$(key_fingerprint "$key_file"); then
        setup_log_error "Could not read GPG fingerprint from: '%s'" "$key_file"
        return 1
    fi

    fpr_act=$(normalize_fingerprint "$fpr_act")

    if [ "$fpr_act" != "$fpr_exp" ]; then
       setup_log_error 'Unexpected key fingerprint:'
       setup_log_error '   File: %s' "$key_file"
       setup_log_error '   Expected: %s' "$fpr_exp"
       setup_log_error '   Actual:   %s' "$fpr_act"
       return 1
    fi

    setup_log_info "Verified key file '$key_file' against '$fpr_exp'."
}


# RPM
import_rpm_key() {
    key_file=$1

    setup_log_info "Importing RPM key from '$key_file'..."
    
    if command -v rpmkeys >/dev/null 2>&1; then
        sudo rpmkeys --import "$key_file" || return 1
    else
        sudo rpm --import "$key_file" || return 1
    fi

    setup_log_info "Imported RPM key from '$key_file'."
}

download_and_import_rpm_key() (
    key_url=$1
    fpr_exp=$2

    if ! command -v curl >/dev/null 2>&1; then
       setup_log_die "curl is not installed. Install before attempting download."
    fi

    setup_log_info "Downloading and importing RPM key from '$key_url' with expected fingerprint '$fpr_exp'..."

    tmpdir=$(mktemp -d) || exit 1
    trap 'rm -rf -- "$tmpdir"' EXIT HUP INT TERM

    key_file="$tmpdir/keyfile"
    
    curl -fsSL -o "$key_file" "$key_url"

    verify_key_file "$key_file" "$fpr_exp" || exit 1

    import_rpm_key "$key_file" || exit 1

    setup_log_info "Downloaded and imported RPM key from '$key_url' with expected fingerprint '$fpr_exp'."
)