### TeX Live
curl -fsSL -o install-tl-unx.tar.gz https://mirror.ctan.org/systems/texlive/tlnet/install-tl-unx.tar.gz
zcat < install-tl-unx.tar.gz | tar xf -
cd install-tl-2*
TL_YEAR=$(./install-tl --version | sed -nE 's/^TeX Live .* version ([0-9]{4})$/\1/p')
perl ./install-tl - --no-interaction -texmfhome "$XDG_DATA_HOME/texlive/texmf" -texmfconfig "$XDG_DATA_HOME/texlive/$TL_YEAR/texmf-config" -texmfvar "$XDG_DATA_HOME/texlive/$TL_YEAR/texmf-var"
TL_ROOT="/usr/local/texlive/$TL_YEAR"
cat >> "$HOME/.profile" <<EOF

# >>> TeX Live environment >>>
export PATH="$TL_ROOT/bin/x86_64-linux:\$PATH"
export MANPATH="$TL_ROOT/texmf-dist/doc/man:\${MANPATH:-}"
export INFOPATH="$TL_ROOT/texmf-dist/doc/info:\${INFOPATH:-}"
# <<< TeX Live environment <<<
EOF

