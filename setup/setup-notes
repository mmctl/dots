# Install (correct versions of) provers CVC5 and Z3 (see EasyCrypt README)

cvcvers=cvc5-1.2.1
cvcdir=cvc5-Linux-x86_64-static-gpl
cvczip=${cvcdir}.zip
curl -fsSL -o "$HOME/${cvczip}" https://github.com/cvc5/cvc5/releases/download/${cvcvers}/${cvczip}
unzip "$HOME/${cvczip}" -d "$XDG_DATA_HOME/srcs/${cvcvers}"
(
  shopt -s dotglob nullglob
  mv -t "$XDG_DATA_HOME/srcs/${cvcvers}" -- "$XDG_DATA_HOME/srcs/${cvcvers}/${cvcdir}"/*
)
rmdir "$XDG_DATA_HOME/srcs/${cvcvers}/${cvcdir}"
rm "$HOME/${cvczip}"
ln -srf "$XDG_DATA_HOME/srcs/${cvcvers}/bin/cvc5" "$XDG_BIN_HOME/cvc5"
ln -srf "$XDG_DATA_HOME/srcs/${cvcvers}/bin/cvc5" "$XDG_BIN_HOME/${cvcvers}"

z3vers=z3-4.13.4
z3dir=z3-4.13.4-x64-glibc-2.35
z3zip=${z3dir}.zip
curl -fsSL -o "$HOME/${z3zip}" https://github.com/Z3Prover/z3/releases/download/${z3vers}/${z3zip}
unzip "$HOME/${z3zip}" -d "$XDG_DATA_HOME/srcs/${z3vers}"
(
  shopt -s dotglob nullglob
  mv -t "$XDG_DATA_HOME/srcs/${z3vers}" -- "$XDG_DATA_HOME/srcs/${z3vers}/${z3dir}"/*
)
rmdir "$XDG_DATA_HOME/srcs/${z3vers}/${z3dir}"
rm "$HOME/${z3zip}"
ln -srf "$XDG_DATA_HOME/srcs/${z3vers}/bin/z3" "$XDG_BIN_HOME/z3"
ln -srf "$XDG_DATA_HOME/srcs/${z3vers}/bin/z3" "$XDG_BIN_HOME/${z3vers}"

