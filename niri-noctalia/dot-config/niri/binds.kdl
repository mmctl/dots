// Niri bindings, Noctalia
binds {
    // General
    //// Focussing/controlling
    Mod+Left { focus-column-or-monitor-left; }
    Mod+Down { focus-window-or-monitor-down; }
    Mod+Up { focus-window-or-monitor-up; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Ctrl+Left { focus-column-first; }
    Mod+Home { focus-column-first; }
    Mod+Ctrl+Right { focus-column-last; }
    Mod+End { focus-column-last; }

    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Ctrl+Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+TouchpadScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+TouchpadScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+BracketLeft { focus-monitor-previous; }
    Mod+BracketRight { focus-monitor-next; }

    Mod+Ctrl+V { switch-focus-between-floating-and-tiling; }

    //// Moving
    Mod+Shift+Left { move-column-left-or-to-monitor-left; }
    Mod+Shift+Down { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up { move-window-up-or-to-workspace-up; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End { move-column-to-last; }

    Mod+Ctrl+Shift+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+TouchpadScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+TouchpadScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }

    Mod+Shift+BracketLeft { move-column-to-monitor-previous; }
    Mod+Shift+BracketRight { move-column-to-monitor-next; }
    
    Mod+Shift+Backslash { move-workspace-to-monitor-previous; }
    Mod+Shift+Slash { move-workspace-to-monitor-next; }
    
    Mod+Shift+Comma { consume-or-expel-window-left; }
    Mod+Shift+Period { consume-or-expel-window-right; }
    
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    
    Mod+W { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Minus { set-column-width "-10%"; }

    Mod+H { switch-preset-window-height; }
    Mod+Shift+H { reset-window-height; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    
    Mod+Shift+V { toggle-window-floating; }
    Mod+Shift+T { toggle-column-tabbed-display; }

    //// Overview
    Mod+O repeat=false { toggle-overview; }

    //// Screenshots
    Print { screenshot; }
    XF86Launch1 { screenshot; }
    Mod+S { screenshot; }
    Ctrl+Print { screenshot-window; }
    Ctrl+XF86Launch1 { screenshot-window; }
    Mod+Ctrl+S { screenshot-window; }
    Shift+Print { screenshot-screen; }
    Shift+XF86Launch1 { screenshot-screen; }
    Mod+Shift+S { screenshot-screen; }

    //// Programs
    Mod+T repeat=false hotkey-overlay-title="Open Terminal (Kitty)" { spawn "kitty"; }
    Mod+B repeat=false hotkey-overlay-title="Open Browser (Zen)" { spawn "flatpak" "run" "app.zen_browser.zen" "-P" "mm"; }
    Mod+E repeat=false hotkey-overlay-title="Open Editor (Emacs)" { spawn "emacsclient" "-c" "--alternate-editor="; }
    Mod+D repeat=false hotkey-overlay-title="Open File Manager (Nautilus)" { spawn "nautilus"; }
    Mod+Z repeat=false hotkey-overlay-title="Open Zotero" { spawn "flatpak" "run" "org.zotero.Zotero"; }
    Mod+Comma repeat=false hotkey-overlay-title="Open Signal" { spawn "flatpak" "run" "org.signal.Signal"; }

    //// Meta
    Mod+Q repeat=false { close-window; }
    Mod+Shift+Escape allow-inhibiting=false repeat=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Ctrl+Shift+Q { quit; }

    //// Help
    Mod+Ctrl+Semicolon repeat=false { show-hotkey-overlay; }

    // Noctalia
    //// Managing
    Mod+Space repeat=false hotkey-overlay-title="Application Launcher" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle";
    }
    Mod+V repeat=false hotkey-overlay-title="Clipboard Manager" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "clipboard";
    }
    Mod+N repeat=false hotkey-overlay-title="Notification Center" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "notifications" "toggleHistory";
    }
    Mod+M repeat=false hotkey-overlay-title="Task Manager" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "systemMonitor" "toggle";
    }
    Ctrl+Shift+Escape repeat=false hotkey-overlay-title="Task Manager" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "systemMonitor" "toggle";
    }

    //// Settings
    Mod+Shift+Semicolon repeat=false hotkey-overlay-title="Settings" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "settings" "toggle";
    }

    //// System
    Super+Alt+L allow-inhibiting=false repeat=false hotkey-overlay-title="Lock Screen" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "lockScreen" "lock";
    }
    Super+Alt+X allow-inhibiting=false repeat=false hotkey-overlay-title="Power Menu" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "sessionMenu" "toggle";
    }

    //// Audio
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "decrease";
    }
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "increase";
    }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true {
        spawn "playerctl" "volume" "0.03-";
    }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true {
        spawn "playerctl" "volume" "0.03+";
    }

    XF86AudioMicMute allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "muteInput";
    }
    XF86AudioMute allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "muteOutput";
    }
    XF86AudioNext allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "next";
    }
    XF86AudioPause allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "playPause";
    }
    XF86AudioPlay allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "playPause";
    }
    XF86AudioPrev allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "previous";
    }

    //// Brightness
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "brightness" "decrease";
    }
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "brightness" "increase";
    }
}
