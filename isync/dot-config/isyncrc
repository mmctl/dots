# Global
BufferLimit 100m


# Personal
## personal@mmeijers.com
IMAPAccount personal-mmeijers
Host mail.your-server.de
User personal@mmeijers.com
PassCmd "rbw get \"Mailbox Personal (mmeijers.com)\""
#TLSType IMAPS
SSLType IMAPS
SSLVersions TLSv1.2 TLSv1.3

IMAPStore personal-mmeijers-remote
Account personal-mmeijers

MaildirStore personal-mmeijers-local
Path  ~/.local/share/mail/personal-mmeijers/
Inbox ~/.local/share/mail/personal-mmeijers/INBOX/
MaxSize 50m
SubFolders Verbatim

Channel personal-mmeijers
Far :personal-mmeijers-remote:
Near :personal-mmeijers-local:
#Sync New Gone Flags
Sync New Delete Flags
Patterns *
Create Both
#Expunge Both
CopyArrivalDate yes
SyncState *

