# editing / UI
ble-face -s region                    "bg={{colors.secondary_container.default.hex}},fg={{colors.on_secondary_container.default.hex}}"
ble-face -s region_target             "bg={{colors.primary_container.default.hex}},fg={{colors.on_primary_container.default.hex}}"
ble-face -s region_match              "bg={{colors.tertiary_container.default.hex}},fg={{colors.on_tertiary_container.default.hex}}"
ble-face -s region_insert             "bg={{colors.secondary_container.default.hex}},fg={{colors.on_secondary_container.default.hex}}"
ble-face -s disabled                  "fg={{colors.outline.default.hex}}"
ble-face -s overwrite_mode            "bg={{colors.primary_container.default.hex}},fg={{colors.on_primary_container.default.hex}}"
ble-face -s vbell                     "reverse"
ble-face -s vbell_erase               "bg={{colors.surface_variant.default.hex}}"
ble-face -s vbell_flash               "fg={{colors.error.default.hex}},reverse"
ble-face -s prompt_status_line        "fg={{colors.on_surface.default.hex}},bg={{colors.surface_variant.default.hex}}"

# core syntax
ble-face -s syntax_default            "fg={{colors.on_surface.default.hex}}"
ble-face -s syntax_command            "fg={{colors.primary.default.hex}},bold"
ble-face -s syntax_quoted             "fg={{colors.secondary.default.hex}}"
ble-face -s syntax_quotation          "fg={{colors.secondary.default.hex}},bold"
ble-face -s syntax_escape             "fg={{colors.tertiary.default.hex}}"
ble-face -s syntax_expr               "fg={{colors.primary.default.hex}}"
ble-face -s syntax_error              "bg={{colors.error.default.hex}},fg={{colors.on_error.default.hex}},bold"
ble-face -s syntax_varname            "fg={{colors.primary.default.hex}}"
ble-face -s syntax_delimiter          "fg={{colors.on_surface_variant.default.hex}},bold"
ble-face -s syntax_param_expansion    "fg={{colors.secondary.default.hex}}"
ble-face -s syntax_history_expansion  "bg={{colors.tertiary_container.default.hex}},fg={{colors.on_tertiary_container.default.hex}}"
ble-face -s syntax_function_name      "fg={{colors.primary.default.hex}},bold"
ble-face -s syntax_comment            "fg={{colors.outline.default.hex}}"
ble-face -s syntax_glob               "fg={{colors.tertiary.default.hex}},bold"
ble-face -s syntax_brace              "fg={{colors.secondary.default.hex}},bold"
ble-face -s syntax_tilde              "fg={{colors.secondary.default.hex}},bold"
ble-face -s syntax_document           "fg={{colors.tertiary.default.hex}}"
ble-face -s syntax_document_begin     "fg={{colors.tertiary.default.hex}},bold"

# command classes
ble-face -s command_builtin_dot       "fg={{colors.primary.default.hex}},bold"
ble-face -s command_builtin           "fg={{colors.primary.default.hex}}"
ble-face -s command_alias             "fg={{colors.secondary.default.hex}}"
ble-face -s command_function          "fg={{colors.primary.default.hex}},bold"
ble-face -s command_file              "fg={{colors.secondary.default.hex}},bold"
ble-face -s command_keyword           "fg={{colors.tertiary.default.hex}},bold"
ble-face -s command_jobs              "fg={{colors.secondary.default.hex}}"
ble-face -s command_directory         "fg={{colors.secondary.default.hex}},underline"
ble-face -s command_suffix            "bg={{colors.secondary_container.default.hex}},fg={{colors.on_secondary_container.default.hex}}"
ble-face -s command_suffix_new        "bg={{colors.error_container.default.hex}},fg={{colors.on_error_container.default.hex}}"

# filenames / paths
ble-face -s filename_directory        "underline,fg={{colors.secondary.default.hex}}"
ble-face -s filename_directory_sticky "underline,bg={{colors.secondary_container.default.hex}},fg={{colors.on_secondary_container.default.hex}}"
ble-face -s filename_link             "underline,fg={{colors.primary.default.hex}}"
ble-face -s filename_orphan           "underline,fg={{colors.error.default.hex}}"
ble-face -s filename_executable       "underline,fg={{colors.tertiary.default.hex}},bold"
ble-face -s filename_setuid           "underline,bg={{colors.error_container.default.hex}},fg={{colors.on_error_container.default.hex}}"
ble-face -s filename_setgid           "underline,bg={{colors.tertiary_container.default.hex}},fg={{colors.on_tertiary_container.default.hex}}"
ble-face -s filename_other            "underline,fg={{colors.on_surface.default.hex}}"
ble-face -s filename_socket           "underline,fg={{colors.primary.default.hex}},bg={{colors.surface_variant.default.hex}}"
ble-face -s filename_pipe             "underline,fg={{colors.tertiary.default.hex}},bg={{colors.surface_variant.default.hex}}"
ble-face -s filename_character        "underline,fg={{colors.on_surface.default.hex}},bg={{colors.surface_variant.default.hex}}"
ble-face -s filename_block            "underline,fg={{colors.on_surface.default.hex}},bg={{colors.surface_variant.default.hex}}"
ble-face -s filename_warning          "underline,fg={{colors.error.default.hex}},bold"
ble-face -s filename_url              "underline,fg={{colors.primary.default.hex}}"
ble-face -s filename_ls_colors        "underline"

# variable classes
ble-face -s varname_array             "fg={{colors.primary.default.hex}},bold"
ble-face -s varname_empty             "fg={{colors.on_surface_variant.default.hex}}"
ble-face -s varname_export            "fg={{colors.primary.default.hex}},bold"
ble-face -s varname_expr              "fg={{colors.primary.default.hex}},bold"
ble-face -s varname_hash              "fg={{colors.secondary.default.hex}},bold"
ble-face -s varname_new               "fg={{colors.secondary.default.hex}}"
ble-face -s varname_number            "fg={{colors.tertiary.default.hex}}"
ble-face -s varname_readonly          "fg={{colors.tertiary.default.hex}},bold"
ble-face -s varname_transform         "fg={{colors.secondary.default.hex}},bold"
ble-face -s varname_unset             "fg={{colors.outline.default.hex}}"

# arguments
ble-face -s argument_option           "fg={{colors.secondary.default.hex}},bold"
ble-face -s argument_error            "bg={{colors.error_container.default.hex}},fg={{colors.on_error_container.default.hex}},bold"

# completions / suggestions
ble-face -s auto_complete             "fg={{colors.outline.default.hex}}"
ble-face -s menu_complete_match       "bold"
ble-face -s menu_complete_selected    "reverse"
ble-face -s menu_desc_default         "none"
ble-face -s menu_desc_type            "ref:syntax_delimiter"
ble-face -s menu_desc_quote           "ref:syntax_quoted"
ble-face -s menu_filter_fixed         "bold"
ble-face -s menu_filter_input         "bg={{colors.tertiary_container.default.hex}},fg={{colors.on_tertiary_container.default.hex}}"
